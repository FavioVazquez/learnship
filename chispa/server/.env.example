# ---------------------------------------------------------------
# Chispa — server environment variables
# Copy this file to .env and fill in your values:
#   cp server/.env.example server/.env
# .env is gitignored and never committed.
# ---------------------------------------------------------------

# Required — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — port the Express server listens on (default: 3001)
PORT=3001

# Optional — allowed CORS origin(s) for the API.
# In development the Vite proxy handles CORS so this is not needed.
# For production deployments where the client and server are on different
# domains, set this to your frontend's public URL:
#   CORS_ORIGIN=https://chispa.yourdomain.com
# CORS_ORIGIN=
