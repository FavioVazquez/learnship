# learnship — environment variables (reference only)
#
# learnship itself does not read a .env file. These are environment variables
# you may already have set for your AI platform; learnship's installer/hooks
# respect them when they are present. Document them here so contributors and
# users know what affects install paths and runtime behavior.

# ─── Platform config directories ──────────────────────────────────────
# Override the install location for each platform. When unset, learnship
# falls back to each platform's documented default.

# Claude Code — default: $HOME/.claude
# CLAUDE_CONFIG_DIR=

# Gemini CLI — default: $HOME/.gemini
# GEMINI_CONFIG_DIR=

# OpenCode — default: $XDG_CONFIG_HOME/opencode or $HOME/.config/opencode
# OPENCODE_CONFIG_DIR=
# XDG_CONFIG_HOME=

# Codex CLI — default: $HOME/.codex
# CODEX_HOME=

# Windsurf is always at $HOME/.codeium/windsurf (no override).

# ─── Platform credentials (used by your AI platform, not learnship) ───
# Listed here so contributors recognize them in error messages and docs.
# learnship hooks check for GEMINI_API_KEY presence to pick the correct
# hook event name (AfterTool vs PostToolUse) — they do not read its value.

# GEMINI_API_KEY=

# ─── Test / development ───────────────────────────────────────────────

# When set, bin/install.js skips running main() and only exports its
# pure functions for unit testing (see tests/validate_multiplatform.sh).
# LEARNSHIP_TEST_MODE=1
